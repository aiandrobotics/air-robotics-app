{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://air-robotics.org/schemas/air-device-profile.schema.json",
  "title": "AirDeviceProfile",
  "description": "Declarative definition of an AIR Robotics compatible BLE device profile.",
  "type": "object",
  "required": [
    "schema_version",
    "model_number",
    "name",
    "manufacturer",
    "gatt",
    "capabilities",
    "actuators",
    "screens"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model_number": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "firmware_compatibility": {
      "type": "object",
      "properties": {
        "min_version": { "type": "string" },
        "max_version": { "type": "string" }
      }
    },
    "gatt": {
      "type": "object",
      "required": [
        "service_uuid",
        "control_point_uuid",
        "telemetry_stream_uuid",
        "configuration_uuid"
      ],
      "properties": {
        "service_uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "control_point_uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "telemetry_stream_uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "configuration_uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["max_channels", "supports_emergency_stop", "supports_raw_preview", "supports_flash_sync"],
      "properties": {
        "max_channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "supports_emergency_stop": { "type": "boolean" },
        "supports_raw_preview": { "type": "boolean" },
        "supports_flash_sync": { "type": "boolean" },
        "supports_calibration_jog": { "type": "boolean" },
        "telemetry_rates": {
          "type": "object",
          "properties": {
            "motion_hz": { "type": "number", "minimum": 1 },
            "idle_hz": { "type": "number", "minimum": 0.1 }
          }
        }
      }
    },
    "actuators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["channel", "name", "role", "min_limit", "max_limit", "default_angle"],
        "properties": {
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "min_limit": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "max_limit": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "default_angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "inverted": { "type": "boolean" }
        }
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" }
        }
      }
    },
    "visualizers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "options": { "type": "object" }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "widgets"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "icon": { "type": "string" },
          "widgets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "title": { "type": "string" },
                "props": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
