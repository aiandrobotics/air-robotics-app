{
  "schema_version": "1.0.0",
  "model_number": "Fabrica-DevKit-v1",
  "name": "Fabrica Cloth Folding Robot",
  "description": "Articulated automated garment folder with 4 planar kinematic flaps and tactile preset slots.",
  "manufacturer": "AIR Robotics",
  "firmware_compatibility": {
    "min_version": "v1.13.0"
  },
  "gatt": {
    "service_uuid": "0000fab0-0000-1000-8000-00805f9b34fb",
    "control_point_uuid": "0000fab1-0000-1000-8000-00805f9b34fb",
    "telemetry_stream_uuid": "0000fab2-0000-1000-8000-00805f9b34fb",
    "configuration_uuid": "0000fab3-0000-1000-8000-00805f9b34fb"
  },
  "capabilities": {
    "max_channels": 4,
    "supports_emergency_stop": true,
    "supports_raw_preview": true,
    "supports_flash_sync": true,
    "supports_calibration_jog": true,
    "telemetry_rates": {
      "motion_hz": 10.0,
      "idle_hz": 1.0
    }
  },
  "actuators": [
    {
      "channel": 0,
      "name": "Left Flap",
      "role": "fold_left",
      "min_limit": 0.0,
      "max_limit": 180.0,
      "default_angle": 0.0,
      "inverted": false
    },
    {
      "channel": 1,
      "name": "Right Flap",
      "role": "fold_right",
      "min_limit": 0.0,
      "max_limit": 180.0,
      "default_angle": 0.0,
      "inverted": false
    },
    {
      "channel": 2,
      "name": "Bottom Flap",
      "role": "fold_bottom",
      "min_limit": 0.0,
      "max_limit": 180.0,
      "default_angle": 0.0,
      "inverted": false
    },
    {
      "channel": 3,
      "name": "Top Flap",
      "role": "fold_top",
      "min_limit": 0.0,
      "max_limit": 180.0,
      "default_angle": 0.0,
      "inverted": false
    }
  ],
  "presets": [
    {
      "id": 1,
      "label": "Button 1",
      "description": "Adult T-Shirt",
      "icon": ""
    },
    {
      "id": 2,
      "label": "Button 2",
      "description": "Long Sleeve",
      "icon": ""
    },
    {
      "id": 3,
      "label": "Button 3",
      "description": "Trousers",
      "icon": ""
    },
    {
      "id": 4,
      "label": "Button 4",
      "description": "Towels",
      "icon": ""
    }
  ],
  "visualizers": [
    {
      "id": "fabrica-flap-grid",
      "type": "canvas_2d",
      "options": {
        "perspective": "planar_top_down",
        "interactive_jog": true
      }
    }
  ],
  "screens": [
    {
      "id": "screen_control",
      "title": "Control",
      "icon": "gamepad",
      "widgets": [
        {
          "type": "status-banner",
          "title": "System Status",
          "props": { "show_led_mirror": true, "show_rssi": true }
        },
        {
          "type": "preset-grid",
          "title": "Folding Presets",
          "props": { "columns": 2 }
        },
        {
          "type": "emergency-stop-button",
          "title": "Emergency Stop",
          "props": { "tactile_feedback": true }
        }
      ]
    },
    {
      "id": "screen_sequencer",
      "title": "Sequencer",
      "icon": "tune",
      "widgets": [
        {
          "type": "visualizer",
          "title": "Fabrica Arrangement",
          "props": { "visualizer_id": "fabrica-flap-grid" }
        },
        {
          "type": "timeline-sequencer",
          "title": "Routine Builder",
          "props": { "max_steps": 16, "allow_preview": true }
        }
      ]
    },
    {
      "id": "screen_arrangement",
      "title": "Arrangement",
      "icon": "grid",
      "widgets": [
        {
          "type": "visualizer",
          "title": "Fabrica Arrangement",
          "props": {
            "visualizer_id": "fabrica-flap-grid",
            "editable": true
          }
        }
      ]
    }
  ]
}
